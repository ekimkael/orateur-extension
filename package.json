{
  "name": "orateur-extension",
  "description": "Extension navigateur pour écouter des articles et sélections de texte avec Orateur.",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "node --test --experimental-test-module-mocks \"lib/**/*.test.ts\" \"tests/*.test.mjs\"",
    "test:packages": "node scripts/check-packages.mjs",
    "test:e2e": "node scripts/test-browser.mjs",
    "test:e2e:firefox": "node scripts/test-browser.mjs firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "onnxruntime-web": "^1.26.0",
    "puppeteer": "25.14.0",
    "typescript": "^5.9.3",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
